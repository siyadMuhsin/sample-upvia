# UPVIA ENVIRONMENT CONFIGURATION

# Backend
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
MONGODB_URI=mongodb://127.0.0.1:27017/upvia
JWT_SECRET=upvia_super_secret_jwt_access_key_2026_enterprise_production
JWT_REFRESH_SECRET=upvia_super_secret_jwt_refresh_key_2026_enterprise_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (for background workers & caching)
REDIS_URL=redis://127.0.0.1:6379

# Storage (S3 / MinIO compatible)
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=upvia-documents
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Email Service
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=upvia_test_user
EMAIL_PASSWORD=upvia_test_password
EMAIL_FROM=noreply@upvia.com

# Client
FRONTEND_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_NAME=Upvia
